FROM hub.mingdao.com/md/documentserverbase:20210805_1610

#EXPOSE 80 443
RUN apt-get -y update && \
    apt-get remove -yq redis-server && \
    apt-get remove -yq --purge redis-server && \
    rm -rf /etc/redis && \
    add-apt-repository ppa:chris-lea/redis-server -y && \
    apt-get -yq install redis
COPY config /app/ds/setup/config/
COPY run-document-server1.sh /app/ds/run-document-server1.sh
COPY web-apps /var/www/onlyoffice/documentserver/web-apps/
COPY docservice /var/www/onlyoffice/documentserver/server/DocService/docservice
ENTRYPOINT ["/app/ds/run-document-server1.sh"]
